<!doctype html>
<html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Zutrittscheck – Kameratest</title>
<style>body{font-family:-apple-system,BlinkMacSystemFont,sans-serif;max-width:720px;margin:auto;padding:20px;line-height:1.45}button,select{font:inherit;padding:12px;border-radius:10px;margin:4px}video{display:block;width:100%;max-height:65vh;background:#111;border-radius:12px;margin-top:12px}.note{background:#f2f4f7;padding:12px;border-radius:10px}#status{font-weight:600}</style></head>
<body><h1>Zutrittscheck – erster iPhone-Test</h1>
<p>Diese Testseite prüft nur, ob Safari die Kamera öffnen kann. Sie liest keine Ausweise, speichert keine Bilder und sendet keine Daten.</p>
<p class="note"><strong>Datenschutz:</strong> Bitte für diesen Test keine Ausweise oder andere persönliche Dokumente vor die Kamera halten. Das Livebild wird nicht aufgezeichnet.</p>
<p id="status">Status: Kamera noch nicht gestartet.</p>
<label for="camera">Kamera:</label><select id="camera"><option value="environment">Rückkamera</option><option value="user">Frontkamera</option></select>
<div><button id="start">Kamera starten</button><button id="stop" disabled>Kamera stoppen</button></div>
<video id="video" autoplay playsinline muted></video>
<script>
(() => {
const video=document.getElementById('video'), status=document.getElementById('status'), camera=document.getElementById('camera'), start=document.getElementById('start'), stop=document.getElementById('stop');
let stream=null;
function setStatus(s){status.textContent='Status: '+s;}
function stopCamera(){if(stream)stream.getTracks().forEach(t=>t.stop());stream=null;video.srcObject=null;start.disabled=false;stop.disabled=true;setStatus('Kamera gestoppt.');}
async function startCamera(){stopCamera();if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){setStatus('Kamerazugriff nicht verfügbar. Bitte HTTPS prüfen.');return;}try{stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:camera.value}},audio:false});video.srcObject=stream;start.disabled=true;stop.disabled=false;setStatus('Kamera aktiv. Es werden keine Bilder gespeichert oder übertragen.');}catch(e){setStatus('Kamerazugriff fehlgeschlagen: '+(e.name||'Fehler')+'. Bitte Safari-Berechtigung prüfen.');}}
start.addEventListener('click',startCamera);stop.addEventListener('click',stopCamera);camera.addEventListener('change',()=>{if(stream)startCamera();});window.addEventListener('pagehide',stopCamera);
})();
</script></body></html>
